<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WxViewer.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">#151413</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
    <style name="Theme.WxViewer" parent="Theme.WxViewer.Base" />
    <style name="Theme.WxViewer.DatePicker.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#141312</item>
        <item name="android:colorBackground">#f3f0e8</item>
        <item name="android:fontFamily">@font/anybody_text</item>
    </style>
    <style name="Theme.WxViewer.DatePicker.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#efebe2</item>
        <item name="android:colorBackground">#151413</item>
        <item name="android:fontFamily">@font/anybody_text</item>
    </style>
</resources>
